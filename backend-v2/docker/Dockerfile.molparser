# syntax=docker/dockerfile:1.7
# MARCUS v2 MolParser worker image (extra "molparser"): the OCSR engine `molparser`
# (worker-molparser, q.molparser), which replaced MolNexTR (owner decision 2026-11-25).
#
# Its own image: MolParser-Mobile-V2's model code needs transformers 5 and a current timm, the
# torch image pins timm 0.4.12 / numpy 1.24 for MolScribe. Same torch build as the torch image
# (2.10.0, cpu or CUDA 12.8 by VARIANT, docker/MODEL_PINS.md).
#
# Model stack (docker/MODEL_PINS.md): every package pinned, resolved for Python 3.11 with
# `uv pip compile --exclude-newer 2026-11-10` against the extra's own lock; the MolParser
# library (dptech-corp/MolParser, Apache-2.0) at a pinned commit, --no-deps (MARCUS imports only
# its recognizer and E-SMILES post-processing: no MolDet / ultralytics, no PDF, no cairosvg).
# On the 140 phase-B crops this stack gives the same SMILES as the library's own `parse`
# (MARCUS-training review-feedback/molparser-eval).
#
# VARIANT (build arg) selects the torch wheel build, as docker/Dockerfile.torch:
#   cpu  (default) torch==2.10.0+cpu from download.pytorch.org/whl/cpu; no CUDA libraries.
#   cuda torch==2.10.0 / torchvision==0.25.0 from PyPI (CUDA 12.8), image marcus-v2-molparser:cuda.
#
# Model files (Hugging Face UniParser/MolParser-Mobile-V2, weights CC BY-NC-SA 4.0) are
# downloaded at BUILD time at a pinned revision, each with its sha256, into
# /opt/models/molparser-mobile-v2; the model code there is the repository's own (loaded with
# trust_remote_code from that folder, hub offline). Runtime needs no network and the root
# filesystem stays read-only.
#
# Targets: `runtime` (the worker, default for compose) and `test` (+ pytest and tests/, for
# `pytest -m ml` in this image). Build context: backend-v2/.

ARG VARIANT=cpu
ARG MODEL_REV=6ee7c0f7e03cde6e5f871f7a764ad4462bb59797

FROM ghcr.io/astral-sh/uv:0.13.9 AS uv

FROM python:3.11-slim-bookworm AS builder
ARG VARIANT
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
ENV UV_COMPILE_BYTECODE=1 UV_COMPILE_BYTECODE_TIMEOUT=600 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-editable --extra molparser
RUN --mount=type=cache,target=/root/.cache/uv \
    case "$VARIANT" in \
      cpu) uv pip install --python /app/.venv/bin/python --no-deps \
             --index-url https://download.pytorch.org/whl/cpu \
             torch==2.10.0+cpu torchvision==0.25.0+cpu ;; \
      cuda) uv pip install --python /app/.venv/bin/python --no-deps \
             torch==2.10.0 torchvision==0.25.0 \
           && uv pip install --python /app/.venv/bin/python \
             nvidia-cublas-cu12==12.8.4.1 nvidia-cuda-cupti-cu12==12.8.90 \
             nvidia-cuda-nvrtc-cu12==12.8.93 nvidia-cuda-runtime-cu12==12.8.90 \
             nvidia-cudnn-cu12==9.10.2.21 nvidia-cufft-cu12==11.3.3.83 nvidia-cufile-cu12==1.13.1.3 \
             nvidia-curand-cu12==10.3.9.90 nvidia-cusolver-cu12==11.7.3.90 \
             nvidia-cusparse-cu12==12.5.8.93 nvidia-cusparselt-cu12==0.7.1 nvidia-nccl-cu12==2.27.5 \
             nvidia-nvjitlink-cu12==12.8.93 nvidia-nvshmem-cu12==3.4.5 nvidia-nvtx-cu12==12.8.90 \
             triton==3.6.0 cuda-bindings==12.9.4 cuda-pathfinder==1.3.3 ;; \
      *) echo "VARIANT must be cpu or cuda" >&2; exit 1 ;; \
    esac
# Model stack (the packages the extra's lock does not already pin).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /app/.venv/bin/python \
      transformers==5.22.2 tokenizers==0.23.3 huggingface-hub==2.4.0 hf-xet==1.8.0 \
      safetensors==0.8.0 timm==1.0.31 opencv-python-headless==5.0.0.93 regex==2026.11.9 \
      pyyaml==6.0.3 tqdm==4.70.1 filelock==4.2.10 fsspec==2026.9.0 jinja2==3.1.6 \
      markupsafe==3.0.4 networkx==3.6.1 sympy==1.14.0 mpmath==1.3.0 \
      annotated-doc==0.0.6 anyio==4.16.0 h11==0.16.0 httpcore2==2.16.0 httpx2==2.16.0 \
      idna==3.20 truststore==0.10.5 typer==0.29.0 shellingham==1.5.4 rich==15.0.0 \
      markdown-it-py==4.3.0 mdurl==0.1.2 pygments==2.21.0 \
    && uv pip install --python /app/.venv/bin/python --no-deps \
      "molparser @ git+https://github.com/dptech-corp/MolParser.git@f8f1e2138de92218992772b6699e7c43867f3585" \
    && { uv pip check --python /app/.venv/bin/python > /tmp/pip-check.txt 2>&1 || true; } \
    && cat /tmp/pip-check.txt \
    && ! grep -E "requires|not installed|incompatib" /tmp/pip-check.txt \
         | grep -vE "^Found [0-9]+ incompatibilit" \
         | grep -vE "molparser\` requires \`cairosvg([<>=!~ ;][^\`]*)?\`, but it's not installed"

# Model files in their own stage, each pinned by revision and sha256.
FROM python:3.11-slim-bookworm AS weights
ARG MODEL_REV
ARG HF=https://huggingface.co/UniParser/MolParser-Mobile-V2/resolve/${MODEL_REV}
ADD --checksum=sha256:2204a871f7975780ead6eee8ac354de11f859c4eccc8863c3462e6f9eb110f02 --chmod=644 \
    ${HF}/model.safetensors /opt/models/molparser-mobile-v2/model.safetensors
ADD --checksum=sha256:bb4b58b3b5e4e0db94af12569171b98737b0866c17aae2aad76ffe5f83e38e84 --chmod=644 \
    ${HF}/config.json /opt/models/molparser-mobile-v2/config.json
ADD --checksum=sha256:9d51ec7c3bde6ce383fe05dcf346aa047db11a8c37133f96a86ad80e0e8b582c --chmod=644 \
    ${HF}/generation_config.json /opt/models/molparser-mobile-v2/generation_config.json
ADD --checksum=sha256:2a70bd084b5e8bcd8fe9e58f08e96ae53740b78c9b5d2af6881ee7a8b15e0db9 --chmod=644 \
    ${HF}/preprocessor_config.json /opt/models/molparser-mobile-v2/preprocessor_config.json
ADD --checksum=sha256:df03c932442eb3917cc486162895eb5fd789d9c93d933fce92301eb40fb876d3 --chmod=644 \
    ${HF}/processor_config.json /opt/models/molparser-mobile-v2/processor_config.json
ADD --checksum=sha256:889fcbf784f1ea9eaef57f32758c972a4bebcaeab3bb2b57c2226e58c161ff83 --chmod=644 \
    ${HF}/tokenizer_config.json /opt/models/molparser-mobile-v2/tokenizer_config.json
ADD --checksum=sha256:891652d9889d68eaaa8b27d490c0a966108e9da5689e67a9473cf5304b3e88fb --chmod=644 \
    ${HF}/vocab.txt /opt/models/molparser-mobile-v2/vocab.txt
ADD --checksum=sha256:c64cbdc618c41f16a5c69d037697c112e8a44e969d3ad92f5605562069950b38 --chmod=644 \
    ${HF}/image_processing_molparser_mobile.py /opt/models/molparser-mobile-v2/image_processing_molparser_mobile.py
ADD --checksum=sha256:b95eb024613114b26968769964b37f2517277e4250d9e7e5fd61fdcf9b0bd065 --chmod=644 \
    ${HF}/modeling_molparser_mobile.py /opt/models/molparser-mobile-v2/modeling_molparser_mobile.py
ADD --checksum=sha256:0109cde7457c78e8401c3b10f4670e7f71eb781d2f0202408cb1e4c111954d3d --chmod=644 \
    ${HF}/processing_molparser_mobile.py /opt/models/molparser-mobile-v2/processing_molparser_mobile.py
ADD --checksum=sha256:ea33f3484caf2d8da6f67b959a324e71b78050d8a6b07d935b9ea7ab22bac6f3 --chmod=644 \
    ${HF}/tokenization_molparser_mobile.py /opt/models/molparser-mobile-v2/tokenization_molparser_mobile.py
RUN chmod -R a+rX /opt/models

FROM python:3.11-slim-bookworm AS runtime
# libgomp1: OpenMP; libxrender1 / libxext6 / libx11-6 / libexpat1: RDKit's drawing module
# (rdMolDraw2D, Cairo), which the warm-up imports; libglib2.0-0: opencv-python-headless.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 libxrender1 libxext6 libx11-6 libexpat1 \
       libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 marcus \
    && useradd --system --uid 10001 --gid marcus --home-dir /nonexistent --shell /usr/sbin/nologin marcus \
    && mkdir -p /data && chown marcus:marcus /data
COPY --from=weights /opt/models /opt/models
COPY --from=builder /app/.venv /app/.venv
COPY src /app/src
RUN echo /app/src > /app/.venv/lib/python3.11/site-packages/marcus.pth \
    && /app/.venv/bin/python -m compileall -q /app/src
WORKDIR /app
# HF_HOME under /tmp (tmpfs at runtime): transformers copies the model's remote code into its
# modules cache before importing it. The hub stays offline.
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    MARCUS_DATA_ROOT=/data HOME=/tmp MPLCONFIGDIR=/tmp/matplotlib HF_HOME=/tmp/hf \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 \
    MARCUS_MOLPARSER_MODEL_DIR=/opt/models/molparser-mobile-v2 MARCUS_WORKER_PROC_ALIVE_TIMEOUT=300
USER marcus
# ONE prefork process per container (= the queue's slots): the model loads when the pool process
# starts (after the fork), never in the parent; a failed load stops the worker.
CMD ["celery", "-A", "marcus.core.celery_app:celery_app", "worker", "-Q", "q.molparser", "-c", "1", \
     "--pool", "prefork", "--include", "marcus.workers.ocsr", "-n", "molparser@%h", \
     "--loglevel", "INFO"]

FROM runtime AS test
USER root
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv pip install --python /app/.venv/bin/python --no-cache \
      pytest==9.2.0 pytest-asyncio==1.5.0 iniconfig==2.3.1 pluggy==1.7.0
COPY pyproject.toml /app/pyproject.toml
COPY tests /app/tests
USER marcus
ENV PYTEST_ADDOPTS="-p no:cacheprovider"
CMD ["pytest", "-m", "ml", "tests/workers/test_molparser_ocsr.py", "-q", "-s"]

FROM runtime
