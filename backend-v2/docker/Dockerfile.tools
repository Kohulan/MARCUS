# syntax=docker/dockerfile:1.7
# MARCUS v2 tools worker image (extra "tools"): CDK depiction / molfile through JPype + RDKit.
# The CDK and centres jars are downloaded at BUILD time and checked against pinned sha256
# values (v1 downloaded them at runtime). Build context: backend-v2/.

FROM ghcr.io/astral-sh/uv:0.13.9 AS uv

FROM python:3.11-slim-bookworm AS jars
ARG CDK_URL=https://github.com/cdk/cdk/releases/download/cdk-2.10/cdk-2.10.jar
ARG CDK_SHA256=2607cc50f438734e74c54b1b7382ecdeeae0317f50bc42005fdeebe9c11f9178
ARG CENTRES_URL=https://github.com/SiMolecule/centres/releases/download/1.0/centres.jar
ARG CENTRES_SHA256=99fd24cfbb73a138942cf30012980d2174b5a185c61739550a118b16ba1f03bd
ADD --checksum=sha256:${CDK_SHA256} ${CDK_URL} /opt/cdk/cdk-2.10.jar
ADD --checksum=sha256:${CENTRES_SHA256} ${CENTRES_URL} /opt/cdk/centres.jar
# Belt and braces: verify again with coreutils (ADD --checksum needs BuildKit dockerfile >= 1.6).
RUN echo "${CDK_SHA256}  /opt/cdk/cdk-2.10.jar" | sha256sum -c - \
    && echo "${CENTRES_SHA256}  /opt/cdk/centres.jar" | sha256sum -c - \
    && chmod 0644 /opt/cdk/*.jar

FROM python:3.11-slim-bookworm AS builder
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_COMPILE_BYTECODE_TIMEOUT=600 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-editable --extra tools

FROM python:3.11-slim-bookworm
# RDKit drawing needs libXrender/libXext; JPype needs a JVM (OpenJDK 17, headless).
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless libxrender1 libxext6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 marcus \
    && useradd --system --uid 10001 --gid marcus --home-dir /nonexistent --shell /usr/sbin/nologin marcus
COPY --from=jars /opt/cdk /opt/cdk
COPY --from=builder /app/.venv /app/.venv
# The project is not copied into the venv: a .pth file puts /app/src on sys.path (like an
# editable install), so a code change rebuilds only this small layer, never the dependency
# layer above. A .pth also works for `python -I` children (PYTHONPATH would be ignored there).
COPY src /app/src
RUN echo /app/src > /app/.venv/lib/python3.11/site-packages/marcus.pth \
    && /app/.venv/bin/python -m compileall -q /app/src
WORKDIR /app
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 MARCUS_CDK_JAR_DIR=/opt/cdk
USER marcus
# Prefork pool (soft time limits need it), concurrency 2, only the tools queue.
CMD ["celery", "-A", "marcus.core.celery_app:celery_app", "worker", "-Q", "q.tools", "-c", "2", \
     "--pool", "prefork", "--include", "marcus.workers.tools", "-n", "tools@%h", "--loglevel", "INFO"]
