# syntax=docker/dockerfile:1.7
# MARCUS v2 API image (extra "api"). The same image runs the dispatcher, `alembic upgrade head`
# (api-migrate) and, in docker-compose.fake.yml, the fake segment / OCSR workers: the api extra
# already carries everything they import (SQLAlchemy, psycopg, Celery, RDKit, Pillow, NumPy).
# Build context: backend-v2/.

FROM ghcr.io/astral-sh/uv:0.10.0 AS uv

FROM python:3.11-slim-bookworm AS builder
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_COMPILE_BYTECODE_TIMEOUT=600 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-editable --extra api

FROM python:3.11-slim-bookworm
RUN groupadd --system --gid 10001 marcus \
    && useradd --system --uid 10001 --gid marcus --home-dir /nonexistent --shell /usr/sbin/nologin marcus \
    && mkdir -p /data && chown marcus:marcus /data
COPY --from=builder /app/.venv /app/.venv
# The project is not copied into the venv: a .pth file puts /app/src on sys.path (like an
# editable install), so a code change rebuilds only this small layer, never the dependency
# layer above. A .pth also works for `python -I` children (PYTHONPATH would be ignored there).
COPY src /app/src
RUN echo /app/src > /app/.venv/lib/python3.11/site-packages/marcus.pth \
    && /app/.venv/bin/python -m compileall -q /app/src
# The admin CLI (`marcus ...`): the project itself is not installed, so write the console
# script `[project.scripts] marcus = "marcus.cli:main"` would have created.
RUN printf '#!/app/.venv/bin/python\nimport sys\nfrom marcus.cli import main\nsys.exit(main())\n' \
        > /app/.venv/bin/marcus \
    && chmod 755 /app/.venv/bin/marcus
COPY alembic.ini /app/alembic.ini
COPY alembic /app/alembic
WORKDIR /app
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    MARCUS_DATA_ROOT=/data HOME=/tmp
USER marcus
EXPOSE 8000
# --forwarded-allow-ips= (empty): uvicorn never rewrites the client from X-Forwarded-For; the
# app's trusted-proxy walk (marcus.api.deps.client_ip) alone decides (R19).
CMD ["gunicorn", "marcus.api.main:create_app(json_logs=True)", "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", "--workers", "2", "--forwarded-allow-ips=", "--worker-tmp-dir", "/tmp"]
