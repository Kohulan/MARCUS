# syntax=docker/dockerfile:1.7
# MARCUS v2 CPU worker image (extra "cpu"): check_pdf, render_page, docling, doi.
# PDF parsing runs in `python -I -m marcus.workers.pdfsafe_child` subprocesses with RLIMIT_AS
# 32 GiB (docling/torch map ~24 GiB of address space); real memory is bounded by the
# container's mem_limit in docker-compose.yml.
# torch comes from uv.lock as locked (PyPI wheel incl. its CUDA libraries), so this image is
# large; it is only ever run on CPU here.
# Docling's models are downloaded at BUILD time into /opt/docling-models and used through
# DOCLING_ARTIFACTS_PATH, so a worker never fetches models at runtime.
# Build context: backend-v2/.

FROM ghcr.io/astral-sh/uv:0.10.0 AS uv

FROM python:3.11-slim-bookworm AS builder
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_COMPILE_BYTECODE_TIMEOUT=600 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-editable --extra cpu

FROM builder AS models
RUN --mount=type=cache,target=/root/.cache/huggingface \
    /app/.venv/bin/docling-tools models download -o /opt/docling-models

FROM python:3.11-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 marcus \
    && useradd --system --uid 10001 --gid marcus --home-dir /nonexistent --shell /usr/sbin/nologin marcus \
    && mkdir -p /data && chown marcus:marcus /data
COPY --from=models /opt/docling-models /opt/docling-models
COPY --from=builder /app/.venv /app/.venv
# The project is not copied into the venv: a .pth file puts /app/src on sys.path (like an
# editable install), so a code change rebuilds only this small layer, never the dependency
# layer above. A .pth also works for `python -I` children (PYTHONPATH would be ignored there).
COPY src /app/src
RUN echo /app/src > /app/.venv/lib/python3.11/site-packages/marcus.pth \
    && /app/.venv/bin/python -m compileall -q /app/src
# pdf2doi writes settings.ini into its own package directory on first import; create it now,
# the root filesystem is read-only at runtime (marcus sets its options in memory only).
RUN /app/.venv/bin/python -c "import pdf2doi" \
    && test -f /app/.venv/lib/python3.11/site-packages/pdf2doi/settings.ini
WORKDIR /app
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    MARCUS_DATA_ROOT=/data HOME=/tmp XDG_CACHE_HOME=/tmp/cache HF_HOME=/tmp/hf \
    HF_HUB_OFFLINE=1 DOCLING_ARTIFACTS_PATH=/opt/docling-models
USER marcus
# q.cpu with 5 processes: SLOTS["q.cpu"] (4) for steps + 1 for the retention purge task;
# -B runs the beat scheduler in this one container (exactly one replica).
CMD ["celery", "-A", "marcus.core.celery_app:celery_app", "worker", "-Q", "q.cpu", "-c", "5", \
     "--include", "marcus.workers.cpu", "-B", "--schedule", "/tmp/celerybeat-schedule", \
     "-n", "cpu@%h", "--loglevel", "INFO"]
