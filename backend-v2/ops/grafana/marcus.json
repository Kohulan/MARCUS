{
  "uid": "marcus-v2",
  "title": "MARCUS v2",
  "tags": [
    "marcus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue pending",
      "datasource": {
        "type": "prometheus",
        "uid": "marcus-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "marcus_queue_pending",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "marcus-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue running",
      "datasource": {
        "type": "prometheus",
        "uid": "marcus-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "marcus_queue_running",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "marcus-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Wait p50 per queue",
      "datasource": {
        "type": "prometheus",
        "uid": "marcus-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, queue) (marcus_wait_seconds_bucket))",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "marcus-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Wait p95 per queue",
      "datasource": {
        "type": "prometheus",
        "uid": "marcus-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, queue) (marcus_wait_seconds_bucket))",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "marcus-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Step seconds p50 / p95 per kind and engine",
      "datasource": {
        "type": "prometheus",
        "uid": "marcus-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, kind, engine) (marcus_step_seconds_bucket))",
          "legendFormat": "p50 {{kind}} {{engine}}",
          "datasource": {
            "type": "prometheus",
            "uid": "marcus-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, kind, engine) (marcus_step_seconds_bucket))",
          "legendFormat": "p95 {{kind}} {{engine}}",
          "datasource": {
            "type": "prometheus",
            "uid": "marcus-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "First SMILES p50 / p95 (per paper, last hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "marcus-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (marcus_first_smiles_seconds_bucket))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "marcus-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (marcus_first_smiles_seconds_bucket))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "marcus-prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Failed steps by class (per hour)",
      "datasource": {
        "type": "prometheus",
        "uid": "marcus-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(marcus_step_failures_total[1h])",
          "legendFormat": "{{error_class}}",
          "datasource": {
            "type": "prometheus",
            "uid": "marcus-prometheus"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Disk free (/data)",
      "datasource": {
        "type": "prometheus",
        "uid": "marcus-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 10737418240
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "marcus_disk_free_bytes{path=\"/data\"}",
          "legendFormat": "free",
          "datasource": {
            "type": "prometheus",
            "uid": "marcus-prometheus"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Dispatcher heartbeat age",
      "datasource": {
        "type": "prometheus",
        "uid": "marcus-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "marcus_dispatcher_heartbeat_age_seconds",
          "legendFormat": "age",
          "datasource": {
            "type": "prometheus",
            "uid": "marcus-prometheus"
          }
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
