# MARCUS v2 local stack: copy to .env (never commit .env) and set the two passwords.
# Use URL-safe values (e.g. `openssl rand -hex 24`): they are embedded in connection URLs.

# Required
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

# API (optional; defaults shown)
# Gunicorn worker processes (uvicorn workers).
GUNICORN_WORKERS=2
# The owner cookie is Secure by default. The local stack is plain http on 127.0.0.1:18090,
# where a browser would drop a Secure cookie: set false only for local http use.
MARCUS_COOKIE_SECURE=true
# Serve /api/v2/docs and /api/v2/redoc.
MARCUS_EXPOSE_DOCS=false
# JSON list of allowed browser origins, e.g. ["http://localhost:5173"]; "*" is refused.
MARCUS_CORS_ORIGINS=[]
# Queues that must have a live consumer for GET /api/v2/ready (comma list). The base stack runs
# q.cpu and q.tools; docker-compose.fake.yml sets q.cpu,q.tools,q.segment,q.fake.
MARCUS_EXPECTED_QUEUES=q.cpu,q.tools
# Allow engine=fake uploads (docker-compose.fake.yml turns this on). Keep 0 otherwise.
MARCUS_ENABLE_FAKE_ENGINES=0
